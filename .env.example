# VITE_GEMINI_API_KEY: Required for Gemini AI API calls (client-side).
# Vite requires the VITE_ prefix to expose env vars to the browser.
# For production, use a backend proxy to protect the key.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase Configuration (Optional for persistent DB; app uses rich mock/sample data by default)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
